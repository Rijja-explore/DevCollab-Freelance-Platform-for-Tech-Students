# ==============================================================================
# DEVCOLLAB — MASTER ENVIRONMENT CONFIGURATION TEMPLATE
# Copy to .env and provide your PayPal Sandbox credentials
# ==============================================================================

# --- PayPal Sandbox Credentials (Service 3 & Frontend) ---
# Obtain from https://developer.paypal.com/dashboard/applications/sandbox
PAYPAL_CLIENT_ID=your_sandbox_client_id_here
PAYPAL_CLIENT_SECRET=your_sandbox_client_secret_here
PAYPAL_MODE=sandbox
PAYPAL_CURRENCY=USD

# --- Discovery & Matching Service (PostgreSQL & Elasticsearch) ---
POSTGRES_DB=devcollab_discovery
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
ELASTICSEARCH_URL=http://elasticsearch:9200

# --- Workspace Collaboration Service (MongoDB) ---
MONGODB_URI=mongodb://mongodb:27017/devcollab_workspace

# --- Escrow Service (MySQL) ---
MYSQL_DATABASE=escrow_db
MYSQL_USER=escrow_user
MYSQL_PASSWORD=escrow_pass
MYSQL_ROOT_PASSWORD=root

# --- Message Broker (RabbitMQ) ---
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# --- Shared Cache (Redis) ---
REDIS_HOST=redis
REDIS_PORT=6379

# --- Frontend Dev Flags ---
VITE_DEV_AUTH=true
