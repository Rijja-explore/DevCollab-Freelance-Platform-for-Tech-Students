# ============================================================
# DevCollab Person C — Payment Escrow & Milestone System
# Environment Variables Example Template
# ============================================================

# Spring Application Profile
SPRING_PROFILES_ACTIVE=docker

# Server Port
PORT=8080

# Database Configuration (MySQL)
DB_HOST=mysql-c
DB_PORT=3306
DB_NAME=escrow_db
DB_USERNAME=escrow_user
DB_PASSWORD=escrow_pass

# RabbitMQ Configuration
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest

# Payment Provider Mode: 'mock' (offline demo) or 'paypal' (live sandbox)
PAYMENT_PROVIDER=mock

# PayPal REST API Credentials (if PAYMENT_PROVIDER=paypal)
PAYPAL_CLIENT_ID=your_paypal_sandbox_client_id_here
PAYPAL_CLIENT_SECRET=your_paypal_sandbox_client_secret_here
PAYPAL_MODE=sandbox
PAYPAL_CURRENCY=USD
PAYPAL_WEBHOOK_ID=your_paypal_webhook_id_here
VITE_PAYPAL_CLIENT_ID=your_paypal_sandbox_client_id_here

# JWT Authentication (Person A Integration)
JWT_ISSUER=devcollab-auth
JWT_PUBLIC_KEY=classpath:keys/public.pem

# Rate Limiting
RATE_LIMIT_REQUESTS_PER_MIN=30
