# ─── Server ───────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development
CORS_ORIGIN=*
LOG_LEVEL=info

# ─── MongoDB ──────────────────────────────────────────────────────────────────
# Docker: use service name "mongodb"
# Local:  use "localhost"
MONGO_URI=mongodb://root:password@mongodb:27017/workspace-service?authSource=admin
MONGO_DB_NAME=workspace-service

# ─── Redis ────────────────────────────────────────────────────────────────────
# Docker: use service name "redis"
# Local:  use "localhost"
REDIS_URL=redis://redis:6379
REDIS_DB=0

# ─── JWT / Authentication ─────────────────────────────────────────────────────
# RS256 public key used to verify tokens issued by the Auth Service.
# Person A: replace keys/public.pem with the production key when ready.
JWT_ALGORITHM=RS256
JWT_PUBLIC_KEY_PATH=keys/public.pem

# ─── RabbitMQ (Phase 8) ───────────────────────────────────────────────────────
# Docker: RABBITMQ_HOST=rabbitmq   (Docker Compose service name)
# Local:  RABBITMQ_HOST=localhost
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_EXCHANGE=devcollab.events

# ─── External HTTP Services ───────────────────────────────────────────────────
# Auth Service (Person A) — set AUTH_SERVICE_ENABLED=true when live
AUTH_SERVICE_URL=http://localhost:3001
AUTH_SERVICE_ENABLED=false

# Notification Service — legacy Phase 6 config, not used in Phase 8
NOTIFICATION_SERVICE_URL=http://localhost:3002
NOTIFICATION_SERVICE_ENABLED=false

SERVICE_TIMEOUT=5000

# ─── Frontend (Vite) ──────────────────────────────────────────────────────────
# Always use localhost — browser connects directly, not via Docker network
VITE_API_URL=http://localhost:5000
VITE_SOCKET_URL=http://localhost:5000
